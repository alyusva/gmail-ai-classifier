# ============================================
# ANTHROPIC API (Claude) — usado en local y en la función cron de Vercel
# ============================================
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================
# GOOGLE OAUTH (Gmail API)
# ============================================
# Uso LOCAL (CLI extract/classify/apply): no hace falta variable de entorno,
# se autentica con credentials.json (ver README.md) y guarda el token en
# data/token.json.
#
# Uso en Vercel (función cron, sin flujo interactivo): configura estas 3
# variables directamente en Vercel (`vercel env add`), NO aquí. Los valores
# de CLIENT_ID/CLIENT_SECRET son los mismos que credentials.json; el
# REFRESH_TOKEN se saca del campo "refresh_token" de data/token.json tras
# hacer login una vez en local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Secret para autenticar las llamadas del cron de Vercel al endpoint
# /api/classify_new (Vercel lo envía automáticamente como
# "Authorization: Bearer $CRON_SECRET"). Genera uno con: openssl rand -hex 32
# CRON_SECRET=

# ============================================
# CONFIGURACIÓN DEL CLASIFICADOR
# ============================================
# Tamaño de lote para clasificación (emails procesados por llamada a Claude)
CLASSIFY_BATCH_SIZE=50

# Label de marca en Gmail: se aplica (sola, sin ser padre de nada) a todo
# email ya procesado, para que el cron detecte correo nuevo con -label:IA.
# Las categorías (Trabajo, Bancos/Finanzas, ...) se crean sueltas, tal cual.
MARKER_LABEL=IA

# Nivel de log (DEBUG, INFO, WARNING, ERROR) — solo aplica al uso local
LOG_LEVEL=INFO
